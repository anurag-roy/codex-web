{
  "name": "codex-web",
  "version": "0.0.1",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "README.md",
    "scratch/asar/**/*",
    "src/server/**/*.js",
    "src/server/**/*.cjs",
    "src/server/electron/index.js",
    "!**/*.ts"
  ],
  "bin": "src/server/main.js",
  "scripts": {
    "prepare": "bun run build",
    "build": "bun run ensure:prepared && bun run build:browser && bun run build:server",
    "launch:unpacked:server": "http-server ./scratch/asar/webview -a localhost -p 5175 -c-1",
    "launch:unpacked": "NODE_ENV=development electron ./scratch/asar --remote-debugging-port=9222",
    "dev:browser": "vite --config vite.browser.config.ts",
    "build:browser": "vite build --config vite.browser.config.ts",
    "build:server": "cd src/server && tsc",
    "ensure:prepared": "(test -f scratch/asar/package.json || ./scripts/prepare) && ./scripts/install_runtime_shims",
    "prepare:asar": "./scripts/prepare_asar",
    "preserver": "bun run build",
    "server": "CODEX_CLI_PATH=$(which codex) bun src/server/main.js"
  },
  "repository": "git@github.com:0xcaff/codex-web.git",
  "author": "martin <martincharles07@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@electron/asar": "^4.2.0",
    "@tanstack/react-query": "^5.100.9",
    "@types/bun": "^1.3.14",
    "glob": "^13.0.6",
    "hono": "^4.12.30",
    "prettier": "^3.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp-cli": "^5.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "41.2.0",
    "http-server": "^14.1.1"
  }
}
